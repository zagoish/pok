{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "download:assets": "node scripts/download-assets.mjs",
    "dist:win": "vite build && electron-builder --win nsis",
    "electron:dev": "vite",
    "electron:preview": "electron ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "typescript": "6.0.2",
    "vite": "6.3.5",
    "vitest": "4.1.10",
    "electron": "33.4.11",
    "electron-builder": "26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pokemonleague.splendor",
    "productName": "宝可梦宝石联赛",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PokemonGemLeague-${version}-setup.${ext}"
    }
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
